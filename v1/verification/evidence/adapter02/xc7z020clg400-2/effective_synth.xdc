####################################################################################
# Constraints from file : 'adapter_interfaces.xdc'
####################################################################################

# CANDIDATE_DIGITAL_PROFILE:4/8-bit SDR50, centre-aligned forwarded clock.
current_instance -quiet
create_generated_clock -name tx50 -source [get_pins transmitter/clkout/forward_oddr/C] -divide_by 1 -invert [get_ports tx_clock]
# External sender changes data at forwarded falling; receiver captures rising.
# Sender data-vs-clock launch offset0..2ns plus allowed relative path skew +/-1ns.
set_input_delay -clock rx50 -clock_fall -max 3.000 [get_ports {{rx_data[*]} rx_valid rx_sof}]
set_input_delay -clock rx50 -clock_fall -min -1.000 [get_ports {{rx_data[*]} rx_valid rx_sof}]
# RX ready launch rising, external sender samples falling; tsu1ns, th0.5ns,
# allowed data-clock differential path +/-1ns => output max2, min-1.5ns.
set_output_delay -clock rx50 -clock_fall -max 2.000 [get_ports rx_ready]
set_output_delay -clock rx50 -clock_fall -min -1.500 [get_ports rx_ready]
set_output_delay -clock tx50 -max 2.000 [get_ports {{tx_data[*]} tx_valid tx_sof}]
set_output_delay -clock tx50 -min -1.500 [get_ports {{tx_data[*]} tx_valid tx_sof}]
# Ready travels out-clock flight + receiver Tco + return path:1..5ns envelope.
set_input_delay -clock tx50 -max 5.000 [get_ports tx_ready]
set_input_delay -clock tx50 -min 1.000 [get_ports tx_ready]
# Management source launches falling, local capture rising, host MISO capture falling.
set_input_delay -clock control25 -clock_fall -max 3.000 [get_ports {control_cs_n control_mosi}]
set_input_delay -clock control25 -clock_fall -min 0.500 [get_ports {control_cs_n control_mosi}]
set_output_delay -clock control25 -clock_fall -max 2.000 [get_ports {control_miso control_ready}]
set_output_delay -clock control25 -clock_fall -min -1.500 [get_ports {control_miso control_ready}]
set_input_delay -clock reference50 -clock_fall -max 3.000 [get_ports {sync_marker marker_qualified arst}]
set_input_delay -clock reference50 -clock_fall -min 0.500 [get_ports {sync_marker marker_qualified arst}]
set_output_delay -clock reference50 -max 2.000 [get_ports {event_out fault_out}]
set_output_delay -clock reference50 -min -1.500 [get_ports {event_out fault_out}]


# User Generated physical constraints 

set_property PACKAGE_PIN U14 [get_ports ref_in]
set_property PACKAGE_PIN U18 [get_ports monitor_in]
