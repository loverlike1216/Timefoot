set_property PACKAGE_PIN G17 [get_ports tx_ready]
set_property PACKAGE_PIN H20 [get_ports rx_valid]
set_property PACKAGE_PIN J20 [get_ports rx_sof]
set_property PACKAGE_PIN G18 [get_ports rx_ready]
set_property PACKAGE_PIN M18 [get_ports control_cs_n]
set_property PACKAGE_PIN M17 [get_ports control_mosi]
set_property PACKAGE_PIN D20 [get_ports control_miso]
