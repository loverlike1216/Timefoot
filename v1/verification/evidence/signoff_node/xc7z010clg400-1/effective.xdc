####################################################################################
# Constraints from file : 'common_clocks.xdc'
####################################################################################

# CANDIDATE_INTERFACE_TIMING: logical single-node OOC integration only.
current_instance -quiet
create_clock -period 20.000 -name reference50 [get_ports ref_in]
create_clock -period 20.000 -name monitor50 [get_ports monitor_in]
create_clock -period 10.000 -name rx100 [get_ports rx_clock]
# Work clock is automatically derived from MMCME2_BASE, never redefined.


####################################################################################
# Constraints from file : 'logical_interfaces.xdc'
####################################################################################

# CANDIDATE_INTERFACE_TIMING. No physical receiver/PHY timing is asserted.
set_input_delay -clock [get_clocks reference50] 2.000 [get_ports {abort_session prepare_valid {prepare_session[*]} {prepare_epoch[*]} {prepare_stage_mask[*]} prepare_source sync_marker marker_qualified run_enable {event_id[*]} {event_session[*]} {event_target[*]} event_valid cancel_all cancel_valid {cancel_id[*]}}]
set_input_delay -clock rx100 2.000 [get_ports {{rx_frame[*]} rx_valid}]
set_input_delay -clock [get_clocks -of_objects [get_pins clocks/bw/O]] 2.000 [get_ports tx_ready]
set_input_delay -clock monitor50 2.000 [get_ports arst]
set_output_delay -clock [get_clocks reference50] 2.000 [get_ports {{timestamp[*]} {session_id[*]} prepared applied time_valid event_execute node_fault clock_ready event_ready {executed_id[*]} {executed_timestamp[*]} {sample_count[*]}}]
set_output_delay -clock monitor50 2.000 [get_ports reference_fault]
set_output_delay -clock rx100 2.000 [get_ports rx_ready]
set_output_delay -clock [get_clocks -of_objects [get_pins clocks/bw/O]] 2.000 [get_ports {{tx_frame[*]} tx_valid fifo_full {fifo_level[*]} {delivered_count[*]}}]


